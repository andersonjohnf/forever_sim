{
  "name": "forever-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke": "vitest run --config vitest.smoke.config.ts && playwright test --grep @smoke",
    "test:full": "npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "snap": "node scripts/snap.mjs --build",
    "scrape:spells": "node scripts/scrape/spells-client.mjs",
    "scrape:talents": "node scripts/scrape/talents-client.mjs",
    "scrape:races": "node scripts/scrape/races-client.mjs",
    "scrape:items": "node scripts/scrape/items-client.mjs",
    "scrape:client": "node scripts/scrape/client.mjs",
    "diff:items": "node scripts/scrape/items-client.mjs --diff",
    "diff:talents": "node scripts/scrape/talents-client.mjs --diff",
    "diff:spells": "node scripts/scrape/spells-client.mjs --diff",
    "diff:races": "node scripts/scrape/races-client.mjs --diff",
    "scrape": "node scripts/scrape/all.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
